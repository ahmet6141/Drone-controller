# /etc/default/dc7 — DC7 companion ortam değişkenleri: RASPBERRY PI 5 (Seviye A)
# Kopyala: sudo cp dc7-rpi.env /etc/default/dc7
DC7_PLATFORM=raspberry_pi
DC7_TIER=tier-a-ekonomik

# Pi 5 UART'ları (/boot/firmware/config.txt; aygıt adlarını Pi 5 overlay belgesinden doğrulayın):
#   dtparam=uart0=on      → GPIO14/15 → /dev/ttyAMA0 : FC TELEM2 (uXRCE-DDS)
#   dtoverlay=uart2-pi5   → GPIO4/5   → /dev/ttyAMA2 : gimbal kontrolcüsü (STorM32)
#   dtoverlay=uart3-pi5   → GPIO8/9   → /dev/ttyAMA3 : FC TELEM1 (MAVLink → mavlink-router)
DC7_DDS_SERIAL=/dev/ttyAMA0
DC7_DDS_BAUD=921600
DC7_GIMBAL_SERIAL=/dev/ttyAMA2
DC7_GIMBAL_BAUD=115200

# ROS 2 — PX4 UXRCE_DDS_DOM_ID ile aynı olmalı (tests/test_configs.py kontrol eder)
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
