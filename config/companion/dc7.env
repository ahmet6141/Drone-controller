# /etc/default/dc7 — DC7 companion ortam değişkenleri: JETSON (Seviye B/C)
# Kopyala: sudo cp dc7.env /etc/default/dc7      (Raspberry Pi 5 için: dc7-rpi.env)
DC7_PLATFORM=jetson
DC7_TIER=tier-b-pro

# FC TELEM2 (uXRCE-DDS) bağlı Jetson UART aygıtı ve hızı — PX4 SER_TEL2_BAUD ile aynı olmalı.
# Aygıt adı taşıyıcı karta göre değişir (Auvidea JNX120X belgesine bakın); seri konsol bu UART'ta kapalı olmalı.
DC7_DDS_SERIAL=/dev/ttyTHS0
DC7_DDS_BAUD=921600

# Gimbal kontrolcüsü (STorM32) — USB-UART adaptörü önerilir (taşıyıcıdan bağımsız)
DC7_GIMBAL_SERIAL=/dev/ttyUSB0
DC7_GIMBAL_BAUD=115200

# ROS 2 — PX4 UXRCE_DDS_DOM_ID ile aynı olmalı (tests/test_configs.py kontrol eder)
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# nvpmodel kip numarası modüle ve JetPack sürümüne göre değişir:
#   grep -n "POWER_MODEL" /etc/nvpmodel.conf   → MAXN_SUPER kipinin ID'sini yazın
DC7_NVPMODEL_MODE=0
